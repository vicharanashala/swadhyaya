# ── Samagama.in Auth ──────────────────────────────────────────
# Required. Get these from the samagama.in auth provider admin console.
NEXT_PUBLIC_SAMAGAMA_AUTH_URL=https://auth.samagama.in
NEXT_PUBLIC_SAMAGAMA_CLIENT_ID=your_client_id_here
NEXT_PUBLIC_SAMAGAMA_REDIRECT_URI=http://localhost:3000/auth/callback

# Server-side only (never expose to the browser)
SAMAGAMA_CLIENT_SECRET=your_client_secret_here

# ── App ──────────────────────────────────────────────────────────
# Public base URL — used for OAuth redirects and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Swadhyaya

# ── Proctoring (opt-in) ──────────────────────────────────────────
# Set to 1 to enable proctoring site-wide plus the admin dashboard at
# /admin/proctor. Off by default.
#
# Turning this ON also relaxes two security headers in next.config.ts,
# because the baseline policy makes the feature impossible:
#   • Permissions-Policy camera=()/microphone=() → (self).  The empty
#     allowlist denies every origin, so getUserMedia is rejected.
#   • CSP gains 'wasm-unsafe-eval', worker-src/media-src blob: for the
#     TF.js + MediaPipe detectors that run in Web Workers.
# connect-src stays at 'self' — all model weights are vendored into
# public/models by scripts/setup-proctor-models.mjs (postinstall), so
# no third-party origin is ever contacted at runtime.
# With this unset the tight original headers are kept verbatim.
NEXT_PUBLIC_PROCTORING=0

# Where attempt records + snapshot evidence are written on the server.
# Defaults to .proctor-data/ in the project root. Use an absolute path
# on a persistent volume in production — serverless filesystems are
# ephemeral and evidence will be lost between invocations.
PROCTOR_DATA_DIR=.proctor-data

# Shared secret for the admin dashboard and every read endpoint under
# /api/proctor. There is no user auth in this app yet (see lib/auth.ts),
# so this token is the only thing standing between the public internet
# and student webcam evidence. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED when NEXT_PUBLIC_PROCTORING=1 — reads are refused without it.
PROCTOR_ADMIN_TOKEN=

# Max snapshot upload size in bytes (default 2 MB) and how many attempts
# to retain server-side before the oldest are pruned (default 500).
PROCTOR_MAX_EVIDENCE_BYTES=2097152
PROCTOR_MAX_ATTEMPTS=500

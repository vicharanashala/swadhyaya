# ── Samagama.in Auth ──────────────────────────────────────────
# Required. Get these from the samagama.in auth provider admin console.
NEXT_PUBLIC_SAMAGAMA_AUTH_URL=https://auth.samagama.in
NEXT_PUBLIC_SAMAGAMA_CLIENT_ID=your_client_id_here
NEXT_PUBLIC_SAMAGAMA_REDIRECT_URI=http://localhost:3000/auth/callback

# Server-side only (never expose to the browser)
SAMAGAMA_CLIENT_SECRET=your_client_secret_here

# ── App ──────────────────────────────────────────────────────────
# Public base URL — used for OAuth redirects and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Swadhyaya

# ── Proctoring (opt-in) ──────────────────────────────────────────
# Set to 1 to enable student-side proctoring panel in every Test tab
# plus the admin dashboard at /admin/proctor. Off by default — when
# unset, ProctorPanel renders a tiny "disabled on this deployment"
# notice and the admin route shows the setup instructions.
#
# Data: every attempt lives in localStorage under 'swadhyaya-proctoring'
# (last 200 per browser). The admin route reads the same key, so opening
# /admin/proctor on the same machine that students tested on shows
# the full history.
NEXT_PUBLIC_PROCTORING=0
